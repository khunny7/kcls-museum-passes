and Teens\">Student Accounts</a></li><li class='desktop mobile'><a href=\"https://kcls.org/studyzone/\" data-ga-category=\"header_sub_level_nav\" data-ga-label=\"Study Zone - Kids and Teens\">Study Zone</a></li></ul></div> </div></div></li>\r\n\t\r\n\t</ul>\r\n\t\r\n\t</nav>\r\n\t\r\n\t</div>\r\n\t</div>\r\n\t<!-- /.cp_header_nav -->\r\n\t\r\n\t<script id=\"t_biblionav_header_nav_xs\" type=\"x-handlebars-template\">\r\n\t<div class=\"navbar yamm navbar-default cp_header_nav\">\r\n\t<nav class=\"col-xs-12\">\r\n\t\r\n\t{{{nav_html}}}\r\n\t\r\n\t</nav>\r\n\t</div>\r\n\t</script>\r\n\t\r\n\t</div>\r\n\t</div><!-- /.cp_header -->\r\n\t</div>\r\n\t<div id=\"overlay\" aria-hidden=\"true\" role=\"application\" data-js=\"overlay-container\" data-test-id=\"overlay-container\">\r\n\t<div class=\"overlay-backdrop\"></div>\r\n\t<div class=\"overlay-inner\">\r\n\t<div class=\"overlay-body\" data-test-id=\"overlay-body\"></div>\r\n\t<a href=\"#close-overlay\" class=\"overlay-close js-close-trigger\" data-test-id=\"overlay-close\">\r\n\t<i aria-hidden=\"true\" class=\" icon-cancel\"></i>\r\n\t<span class=\"sr-only\">Close Dialog</span>\r\n\t</a>\r\n\t</div>\r\n\t</div>\r\n\t</div>\r\n\r\n\t<!-- END EXTERNAL HEADER -->\r\n\t\r\n\t<!-- BC END HEADER -->\r\n</div>\n<div class=\"container\">\n    \n    <div id=\"s-lc-public-bc\" class=\"row\">\n        <div class=\"col-md-12\">\n            <nav aria-label=\"Breadcrumb\">\n                <ol class=\"breadcrumb\">\n                    <li><a href=\"http://kcls.org\">King County Library System</a></li>\n\n                    <li class=\"s-lc-desktop-only\"><a href=\"https://rooms.kcls.org\">Public Room Reservations - KCLS</a></li>\n\n                                            <li><a href=\"/passes\">Museum Passes</a></li>\n                                            <li><a href=\"/passes/cd3534a4e786\">Rhododendron Botanical Garden</a></li>\n                    \n                                            <li class=\"active s-lc-desktop-only\">Create Booking</li>\n                    \n                                                        </ol>\n            </nav>\n        </div>\n    </div>\n\n    <noscript>\n        <div class=\"alert alert-danger\" id=\"noscript\">Your browser has javascript disabled. Without javascript some functions will not work.</div>\n    </noscript>\n\n    <div id=\"s-lc-public-title-area\">\n                                    <div id=\"s-lc-public-title\" class=\"row\">\n                    <div class=\"col-md-12\">\n                        <h1 id=\"s-lc-public-pt\">Reservation Details</h1>\n                    </div>\n                </div>\n            \n                        </div>\n\n    <main>\n            <div id=\"s-lc-public-main\" class=\"s-lc-public-main\">\n        <div id=\"s-lc-public-page-content\" class=\"row\">\n            <div id=\"col1\" class=\"col-md-12 center\">\n\n                <h2 class=\"sr-only\">\n                    Booked Items                </h2>\n\n                <div class=\"table-responsive\">\n    <table class=\"table s-lc-eq-checkouttb\">\n                                                        <thead>\n        <tr>\n            <th>\n                Institution            </th>\n            <th>\n                Type            </th>\n                        <th>\n                Date            </th>\n        </tr>\n        </thead>\n        <tbody>\n            <tr>\n                <td class=\"s-lc-booking-name\">\n                                            <img src=\"https://d2jv02qf7xgjwx.cloudfront.net/customers/3774/images/Rhododendron_Species_Botanical_Garden.png\" alt=\"Rhododendron Botanical Garden\" class=\"img-rounded s-lc-image-thumbnail hidden-xs\">\n                                        <strong>Rhododendron Botanical Garden</strong>\n                    <!-- pass: RBG -->\n                </td>\n                <td>\n                    Digital Pass                </td>\n                                <td>\n                    Sunday, December 21, 2025\n                </td>\n            </tr>\n        </tbody>\n    </table>\n</div>\n\n                                                            <div id=\"bform-terms-container\">\n                            <h2 class=\"sr-only\">\n                                Additional Notes\n                            </h2>\n\n                            <form class=\"form-horizontal\" name=\"s-lc-eq-terms\" id=\"s-lc-eq-terms\" method=\"post\" autocomplete=\"off\">\n                                <div class=\"s-lc-eq-co-terms\">\n                                    <h3>\n                                        Rhododendron Botanical Garden:\n                                        Additional Notes\n                                    </h3>\n\n                                    <div class=\"s-lc-eq-co-terms-internal s-lc-eq-co-terms-museum\">\n                                        <p paraeid=\"{2a605ce7-2e1c-40c0-9783-1817ac4b9796}{209}\" paraid=\"1577083747\"><strong>Hours &amp; Admission&nbsp;</strong></p>\r\n\r\n<p paraeid=\"{2a605ce7-2e1c-40c0-9783-1817ac4b9796}{215}\" paraid=\"81997668\"><em><strong>You must show a printed or digital pass AND matching photo ID to enter. </strong>Contact the garden at (253) 838-4646 with questions about admission requirements.&nbsp;</em></p>\r\n\r\n<p paraeid=\"{2a605ce7-2e1c-40c0-9783-1817ac4b9796}{237}\" paraid=\"1437744966\">Pass provides general admission at no charge during regular open hours. Hours may vary. View current open hours and plan your visit at <a href=\"https://rhodygarden.org/\" rel=\"noreferrer noopener\" target=\"_blank\">rhodygarden.org</a>.&nbsp;</p>\r\n\r\n<p paraeid=\"{f23c5ace-1d04-44e4-8edd-2cc5e7d16ae7}{1}\" paraid=\"1970786967\">&nbsp;</p>\r\n\r\n<p style=\"margin-bottom:10px; text-align:justify\"><span style=\"font-size:12pt\"><span style=\"background:white\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span style=\"font-size:10.5pt\"><span style=\"font-family:&quot;Helvetica&quot;,sans-serif\"><span style=\"color:#333333\"></span></span></span></span></span></span></span></p>\r\n\n                                    </div>\n                                </div>\n\n                                <div id=\"s-lc-eq-tc-buts\">\n                                    <button class=\"btn btn-primary\" type=\"submit\" id=\"terms_accept\">\n                                        Agree\n                                    </button>\n                                </div>\n                            </form>\n                        </div>\n                    \n                    <div id=\"bform-form-container\" class=\"s-lc-booking-form\" style=\"display: none;\">\n                        <h2 class=\"sr-only\">\n                            Booking Form                        </h2>\n\n                        <form class=\"form-horizontal\" name=\"s-lc-bform\" id=\"s-lc-bform\" method=\"post\" action=\"/passes/cd3534a4e786/book\" autocomplete=\"off\">\n                            <input type=\"hidden\" id=\"museum\" name=\"museum\" value=\"cd3534a4e786\">\n\n                            <input type=\"hidden\" id=\"pass\" name=\"pass\" value=\"658bbe1ee133\">\n\n                            <input type=\"hidden\" id=\"date\" name=\"date\" value=\"2025-12-21\">\n\n                            <input type=\"hidden\" id=\"crc\" name=\"crc\" value=\"7b038ea790377f3c21f0737027e40593\">\n\n                            <div id=\"s-lc-bform-help\" class=\"s-lc-booking-form-help\" tabindex=\"-1\">\n                                Fill out this form to complete the booking.\n                            </div>\n\n                                                        \n                            \n    \n\n\n\n\n<div class=\"form-group margin-bottom-none\">\n    <div class=\"col-md-offset-3 col-md-9\">\n        <div class=\"pull-right text-muted margin-top-med\">* is required</div>\n    </div>\n</div>\n\n<div class=\"form-group s-lc-passes-q s-lc-name\">\n    <span class=\"col-md-3 col-xs-12 control-label s-lc-passes-lab\">\n        Full Name *\n    </span>\n\n            <div class=\"col-md-9\">\n            <p class=\"form-control-static\">YOUNG GIM</p>\n        </div>\n    </div>\n\n\n<div class=\"form-group s-lc-passes-q s-lc-email\">\n    <label for=\"s-lc-passes-form-email\" class=\"col-md-3 control-label s-lc-passes-lab\">\n        Email\n            </label>\n\n    <div class=\"col-md-9\">\n                    <p class=\"form-control-static\">khunny7@live.com</p>\n            </div>\n</div>\n\n\n    \n    \n\n\n\n\n<div class=\"form-group s-lc-passes-q slc-hi\" id=\"slch_Feedback-cntr\">\n    <label class=\"control-label\" for=\"s-lcxp-Feedback\">Feedback</label>\n    <input id=\"s-lcxp-Feedback\" name=\"Feedback\" value=\"\" type=\"text\" class=\"form-control\" required=\"required\" aria-required=\"true\" autocomplete=\"off\">\n</div>\n<script>\n    var element = document.getElementById(\"slch_Feedback-cntr\"); element.parentNode.removeChild(element);\n</script>\n\n                            <div class=\"form-group\">\n                                <div class=\"col-md-offset-3 col-md-9\">\n                                    <button class=\"btn btn-primary\" type=\"submit\" id=\"btn-form-submit\">\n                                        Reserve\n                                    </button>\n\n                                        <a href=\"/pass/logout\" id=\"s-lc-pass-auth-logout\" class=\"btn btn-info pull-right s-lc-pass-auth-logout\">\n        Logout\n    </a>\n                                </div>\n                            </div>\n                        </form>\n                    </div>\n                \n            </div>\n        </div>\n    </div>\n    </main>\n\n    <footer id=\"s-lc-public-footer\" class=\"row s-lc-public-footer\">\n        <div id=\"s-lc-public-footer-brand\">\n    <span title=\"libcal-us-7\">Powered by</span> <a h