          "content": {
            "size": 12579,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <!-- iid: 6790 -->\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n            \n            <link href=\"https://static-assets-us.libcal.com/bootstrap_14/bootstrap3.min.css\" rel=\"stylesheet\">\n    \n\n    <link href=\"//cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css\" rel=\"stylesheet\">\n    <link href=\"https://static-assets-us.libcal.com/css_912/LibCal_public.min.css\" rel=\"stylesheet\">\n    <link href=\"https://static-assets-us.libcal.com/css_912/print.min.css\" rel=\"stylesheet\" media=\"print\">\n    \n<script src=\"https://static-assets-us.libcal.com/jquery_16/jquery.min.js\"></script>\n\n\n<script src=\"https://static-assets-us.libcal.com/bootstrap_14/bootstrap3.min.js\"></script>\n    <script src=\"https://static-assets-us.libcal.com/js_912/LibCal_public.min.js\"></script>\n        <script>\n    springSpace.dateFormat = \"dddd, MMMM D, YYYY\";\n    springSpace.dateShortFormat = \"ddd MMM Do YYYY\";\n    springSpace.timeFormat = \"h:mm A\";\n    springSpace.timezone = 'America/Los_Angeles';\n    springSpace.currency = \"USD\";\n\n    springSpace.language = 'en'; // en\n    springSpace.locale = 'en-US'; // en-US\n\n    springSpace.phpTimeFormat = 'g:i A';\n\n    springSpace.bootstrapAsset = 'https://static-assets-us.libcal.com/bootstrap_14/bootstrap3_16.min.css';\n    springSpace.publicCssAsset = 'https://static-assets-us.libcal.com/css_912/LibCal_public.min.css';\n    springSpace.adminCssAsset = 'https://static-assets-us.libcal.com/css_912/LibCal_admin.min.css';\n</script>\n        <title>\n                    Museum of Flight -\n                Museum Pass -\n        The Seattle Public Library\n    </title>\n    <style>\n            #s-lc-public-banner {\n            padding: 0;\n            margin: 0;\n        }\n\n        .s-lc-public-footer {\n            margin: 0;\n        }\n    </style>\n        <style>\n    .s-lc-pass-available {\n        background: #A1D4A6 none !important;\nborder-color: #A1D4A6 !important;\ncolor: #050000 !important;    }\n\n    .s-lc-pass-available:hover {\n        background: #55A15F none !important;\nborder-color: #55A15F !important;\ncolor: #0A0000 !important;    }\n\n    .s-lc-pass-unavailable {\n        background: #E3C084 none !important;\nborder-color: #E3C084 !important;\ncolor: #000000 !important;    }\n\n    .s-lc-pass-not-yet-available {\n        background: #BABAB3 none !important;\nborder-color: #BABAB3 !important;\ncolor: #000000 !important;    }\n\n    .s-lc-pass-closed {\n        background: #737373 none !important;\nborder-color: #737373 !important;\ncolor: #FCF9F9 !important;    }\n</style>\n\n    <link rel=\"stylesheet\" href=\"https://static-assets-us.libcal.com/fullcalendar_14/fullcalendar.min.css\"/>\n    <link rel=\"stylesheet\" href=\"https://static-assets-us.libcal.com/css_912/datepicker.min.css\"/>\n    <style>\r\n@import url('https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap');\r\n\r\n\r\n/* set font family */\r\nbody, a {\r\n\tfont-family: 'Open Sans', sans-serif;\r\n}\r\n\r\n/* hide breadcrumbs - screen and screenreader */\r\n.breadcrumb li:first-child,\r\n.breadcrumb .s-lc-desktop-only {\r\n\tdisplay: none;\r\n\tvisibility: hidden;\r\n}\r\n</style>\n</head>\n<body id=\"museum\" class=\"s-lc-public s-lc-public-page-5\">\n\n\n<a id=\"s-lc-public-skiplink\" class=\"s-lc-skiplink alert-info\" href=\"#s-lc-public-title-area\">Skip to Main Content</a>\n\n<div id=\"s-lc-public-cust-header\" role=\"banner\"><div class=\"row\">\r\n\t<div class=\"col-md-12\">\r\n\t\t<a href=\"https://www.spl.org\">\r\n\t\t\t<img src=\"https://d2jv02qf7xgjwx.cloudfront.net/customers/5821/images/museumpass_500x120.jpg\" alt=\"go to Seattle Public Library homepage\">\r\n\t\t</a>\r\n\t<div>\r\n</div></div>\n<div class=\"container\">\n    \n    <div id=\"s-lc-public-bc\" class=\"row\">\n        <div class=\"col-md-12\">\n            <nav aria-label=\"Breadcrumb\">\n                <ol class=\"breadcrumb\">\n                    <li><a href=\"http://www.spl.org\">The Seattle Public Library</a></li>\n\n                    <li class=\"s-lc-desktop-only\"><a href=\"https://spl.libcal.com\">Museum Pass</a></li>\n\n                                            <li><a href=\"/passes\">Institution Passes</a></li>\n                    \n                                            <li class=\"active s-lc-desktop-only\">Museum of Flight</li>\n                    \n                                                        </ol>\n            </nav>\n        </div>\n    </div>\n\n    <noscript>\n        <div class=\"alert alert-danger\" id=\"noscript\">Your browser has javascript disabled. Without javascript some functions will not work.</div>\n    </noscript>\n\n    <div id=\"s-lc-public-title-area\">\n            <div id=\"s-lc-public-title\" class=\"row\">\n        <div class=\"col-md-12\">\n            <h1 id=\"s-lc-public-pt\">Museum of Flight</h1>\n        </div>\n    </div>\n\n    \n    <div id=\"s-lc-public-pd\" class=\"row\">\n        \n        <div class=\"col-sm-8\">\n                                    \n                            <p class=\"s-lc-child-header margin-bottom-sm s-lc-pass-address\">\n                    9404 E. Marginal Way South, Seattle, WA, 98108-4097\n                                                            <a href=\"https://maps.apple.com/?address=9404%20E.%20Marginal%20Way%20South%2C%20Seattle%2C%20WA%2C%2098108-4097%2C%20United%20States%20of%20America\" title=\"Open map for Museum of Flight\" target=\"_blank\">\n    Map\n    <i class=\"fa fa-external-link\" aria-hidden=\"true\"></i>\n</a>\n                </p>\n            \n                            <p class=\"s-lc-pass-phone\">\n                    <i class=\"fa fa-lg fa-phone margin-right-sm\" aria-hidden=\"true\"></i>\n                    <a href=\"tel:206-764-5700\">\n                        206-764-5700\n                    </a>\n                </p>\n            \n            <p><strong>This pass admits 2 adults and 2 children (ages 5-17) for general admission to the Museum of Flight. Children 4 and under are admitted for free. Pass must be present upon entry along with photo I.D. Charges may apply for interactive experiences, special exhibitions, and additional visitors.</strong></p>\r\n\r\n<p><br />\r\nThe history of aviation and aerospace comes alive at The Museum of Flight! Explore the Apollo Exhibit. Walk the halls of Air Force One and the Concorde. Stand beneath the Blackbird spy plane. Marvel at the heroics of WWI and WWII. Plus, flight simulators, 3-D movies, the Space Shuttle Trainer and more. Plus educational programs that make learning fun. A great Museum for the family rain or shine. Always free parking. Take Metro 124 from downtown.</p>\r\n\n\n                            <a href=\"https://www.museumofflight.org/\" target=\"_blank\" class=\"s-lc-museum-link\">\n        Visit Website        <i class=\"fa fa-external-link\" aria-hidden=\"true\"></i><span class=\"sr-only\">This link opens in a new window</span></a>            \n            \n<div class=\"s-lc-avail-content\">\n    <h2 class=\"s-lc-public-subheader\">\n        Passes Availability\n    </h2>\n\n            <p>\n            Digital (downloadable via email) passes are available. Select your desired visit date from the calendar below.\n        </p>\n    </div>\n\n<div id=\"s-lc-availability-options\" class=\"s-lc-pass-availability-options\"  style=\"display: none;\">\n    <form class=\"form form-inline\" autocomplete=\"off\">\n                    <div class=\"form-group form-group-sm\" id=\"s-lc-digital_container\">\n    <label class=\"checkbox checkbox-inline\" for=\"s-lc-digital\">\n        <input type=\"checkbox\" id=\"s-lc-digital\" name=\"s-lc-digital\" class=\"s-lc-checkbox-alignment-fix s-lc-view-type\" value=\"1\" checked=\"checked\">\n        Show Digital Pass Availability\n            </label>\n</div>\n\n            <div class=\"form-group form-group-sm\" id=\"s-lc-physical_container\">\n    <label class=\"checkbox checkbox-inline\" for=\"s-lc-physical\">\n        <input type=\"checkbox\" id=\"s-lc-physical\" name=\"s-lc-physical\" class=\"s-lc-checkbox-alignment-fix s-lc-view-type\" value=\"1\">\n        Show Physical Pass Availability\n            </label>\n</div>\n        \n        \n        <div class=\"form-group form-group-sm\">\n            <select\n                id=\"s-lc-location\"\n                name=\"s-lc-location\"\n                class=\"form-control input-sm s-lc-view-type\"\n            >\n                \n\n    <option value=\"\" selected=\"selected\">Select Location</option>\n\n\n\n\n\n\n\n\n            </select>\n        </div>\n    </form>\n</div>\n        </div>\n\n                    <div class=\"col-sm-4\">\n                <img class=\"s-lc-desktop-only img-rounded img-responsive\" src=\"https://d68g328n4ug0e.cloudfront.net/misc/6790/pass/museum/2025_06_11_08_18_06.jpg\" alt=\"Image of the Institution\" />\n            </div>\n            </div>\n    </div>\n\n    <main>\n            <div id=\"s-lc-public-main\" class=\"s-lc-public-main s-lc-pass-museum\">\n        <div id=\"s-lc-availability-content\">\n            <div id=\"s-lc-pass-controls\" class=\"row s-lc-pass-controls\">\n                <div class=\"col-xs-4 col-xs-push-4\">\n                    <h2 id=\"s-lc-displaydate\">\n                                                February 2026\n                    </h2>\n                </div>\n\n                <div class=\"col-xs-4 col-xs-pull-4 s-lc-pass-date-buttons\">\n                    <div class=\"btn-group\">\n    <button type=\"button\" class=\"btn btn-default fc-prev-button\" id=\"s-lc-date-prev\">\n        &nbsp;\n        <span class=\"fa fa-lg fa-angle-left\">\n            <span class=\"sr-only\">\n                Previous\n            </span>\n        </span>\n        &nbsp;\n    </button>\n\n    <button type=\"button\" class=\"btn btn-default fc-next-button\" id=\"s-lc-date-next\">\n        &nbsp;\n        <span class=\"fa fa-lg fa-angle-right\">\n            <span class=\"sr-only\">\n                Next\n            </span>\n        </span>\n        &nbsp;\n    </button>\n</div>\n                    <button class=\"btn btn-success\" id=\"s-lc-timegrid-loading\" style=\"display: none;\">\n    <i class=\"fa fa-refresh fa-spin\" aria-hidden=\"true\">\n        <span class=\"sr-only\" aria-hidden=\"true\">\n            Working...\n        </span>\n    </i>\n</button>\n                </div>\n            </div>\n\n            <div id=\"s-lc-pass-availability-loading\" class=\"s-lc-pass-availability-loading\">\n                <i class=\"fa fa-spinner fa-spin fa-lg\" aria-hidden=\"true\"></i>\n                Determining Availability            </div>\n\n            <div id=\"s-lc-pass-availability-content\" class=\"s-lc-pass-availability-content\" style=\"display: none;\">\n                            </div>\n        </div>\n    </div>\n    </main>\n\n    <footer id=\"s-lc-public-footer\" class=\"row s-lc-public-footer\">\n        <div id=\"s-lc-public-footer-brand\">\n    <span title=\"libcal-us-3\">Powered by</span> <a href=\"https://www.springshare.com\">Springshare</a>.\n</div>\n\n<div id=\"s-lc-public-footer-rights\">\n    All rights reserved.\n</div>\n\n    <div id=\"s-lc-footer-support-link\">\n        <a href=\"mailto:museumpass@spl.org\">Report a tech support issue.</a>\n    </div>\n\n                \n        <div id=\"s-lc-public-footer-admin-links\" role=\"navigation\" aria-label=\"Admin Footer\">\n                            <a id=\"s-lc-sign-in\" href=\"https://spl.libapps.com/libapps/login.php?site_id=26752&amp;target=\">Login to LibApps</a>\n                    </div>\n\n        <div class=\"s-lc-public-footer-actions\">\n    \n<div id=\"s-lc-language\">\n    <select id=\"s-lc-language-selector\" aria-label=\"Select Language\">\n                <option value=\"ca\" >català</option>\n                <option value=\"cy\" >Cymraeg</option>\n                <option value=\"en\" selected>English</option>\n                <option value=\"es\" >español</option>\n                <option value=\"fr\" >français</option>\n                <option value=\"ga\" >Irish</option>\n                <option value=\"ja\" >日本語 Nihongo</option>\n                <option value=\"nl\" >Nederlands</option>\n                <option value=\"sl\" >slovenski jezik</option>\n                <option value=\"vi\" >Tiếng Việt</option>\n                <option value=\"zh\" >中文 Zhōngwén</option>\n            </select>\n</div>\n</div>\n    </footer>\n\n    \n</div>\n\n\n            <script>\n            var springyPage = {\n                museum: '3cec43a0d6e8',\n                viewStart: '2026\\u002D02\\u002D02',\n                viewingDate: null,\n                startOfMonth: null,\n            };\n        </script>\n    \n    <script defer src=\"https://static-assets-us.libcal.com/js_912/datepicker.min.js\"></script>\n    <script defer src=\"https://static-assets-us.libcal.com/js_912/direct/public/passes/museum.min.js\"></script>\n\n\n\n</body>\n</html>\n"
